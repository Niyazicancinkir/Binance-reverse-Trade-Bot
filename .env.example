# ==============================================================================
# BINANCE REVERSE TRADE BOT - ÇEVRE DEĞİŞKENLERİ (.env)
# ==============================================================================

# 1. Binance API Bilgileri
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET_KEY=your_binance_secret_key
# Demo / Testnet modu için 'true', Gerçek hesap için 'false'
BINANCE_DEMO=true

# 2. Gemini AI Bilgileri
GEMINI_API_KEY=your_gemini_api_key
# Model adı (varsayılan: gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# 3. Telegram ve Strateji Parametreleri
TELEGRAM_CHANNEL=cryptosignals0rg

# Kaldıraç Çarpanı (Örnek: 1, 3, 5, 10, 20)
LEVERAGE=5

# Marjin Modu: ISOLATED (İzole) veya CROSSED (Çapraz)
MARGIN_MODE=ISOLATED

# İşlem Başına Büyüklük (USDT cinsinden yaklaşık marjin değeri)
TRADE_AMOUNT_USDT=10.0

# 4. Otomasyon ve Tarama Ayarları
# Arka plan / döngü modunda tarama aralığı (saniye cinsinden)
SCAN_INTERVAL_SECONDS=60

# main.py başlatıldığında sürekli döngüde çalışsın mı? (true/false)
AUTO_LOOP=false

# 5. Dosya Yolları
EXCEL_FILE=islem_gecmisi.xlsx
TRACKER_FILE=islenen_sinyaller.json